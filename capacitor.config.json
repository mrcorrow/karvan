{
  "appId": "com.karvan.app",
  "appName": "Karvan",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0f3d2e"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0f3d2e",
      "showSpinner": false
    }
  }
}
